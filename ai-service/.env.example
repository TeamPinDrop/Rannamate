# RANNAMATE AI service — copy to .env. Placeholders only; never commit real keys.
# Shared secret the NestJS backend sends as X-Internal-Key (must equal AI_SERVICE_API_KEY in backend/.env)
AI_SERVICE_API_KEY=

# Model provider (set ONE). Without a key, AI endpoints answer 503 AI_PROVIDER_NOT_CONFIGURED — nothing is faked.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Only the backend should call this service. Bind to localhost in development.
HOST=127.0.0.1
PORT=8000
