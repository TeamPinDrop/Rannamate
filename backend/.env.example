# ─────────────────────────────────────────────────────────────────────────────
# RANNAMATE backend — copy to .env and fill in. Placeholders only: never commit real values.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Browser origins allowed to call the API (comma-separated). The Next.js frontend runs on 3000 (or 3001).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where data lives:
#   mysql  — the existing `ranna_mate` database (default). Until the schema is mapped,
#            database-backed endpoints answer 503 SCHEMA_NOT_VERIFIED (see docs/DATABASE_MAPPING.md).
#   memory — explicit, temporary in-memory store for local development and tests. Data is lost on restart.
DATA_SOURCE=mysql

# MySQL (configured later — leave blank until the connection details are provided)
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=ranna_mate_updated
# Optional: only after the DB owner runs docs/sql/password_resets.sql (enables password reset in MySQL mode)
DB_PASSWORD_RESETS_TABLE=

# Auth — each secret must be at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
# "Remember me" / new-account sessions, and sessions that end when the browser closes (server-side limit)
JWT_REFRESH_TTL=30d
SESSION_TTL=12h

# Where the website runs (used in password-reset links and after Google sign-in) and the API's public URL
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Session cookies are always HttpOnly. Secure defaults to true when NODE_ENV=production (required there).
# Frontend and API on different sites (not just different ports)? use COOKIE_SAMESITE=none + COOKIE_SECURE=true.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Password-reset email over SMTP. Leave SMTP_HOST empty to switch reset emails off — the app then says so
# honestly (503 EMAIL_NOT_CONFIGURED) and never claims an email was sent.
#   Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30

# Optional "Continue with Google" (OAuth 2.0 / OpenID Connect). Create a "Web application" OAuth client in
# Google Cloud Console → APIs & Services → Credentials, and add this exact Authorized redirect URI:
#   http://localhost:4000/api/v1/auth/google/callback   (or $API_PUBLIC_URL/api/v1/auth/google/callback)
# Leave both empty and the Google button is not shown anywhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Internal FastAPI AI service (ai-service/). The key must match AI_SERVICE_API_KEY there.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Photo storage for Tastory (private by default; served only through short-lived signed URLs)
#   local — files on this machine under STORAGE_LOCAL_DIR (development)
#   s3    — reserved for a cloud bucket; not implemented yet
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=./storage/private
STORAGE_SIGNING_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# Optional: recommendation weights as JSON (must cover I, M, C, W, T, P, H)
# RECO_WEIGHTS={"I":0.35,"M":0.15,"C":0.15,"W":0.10,"T":0.10,"P":0.10,"H":0.05}
