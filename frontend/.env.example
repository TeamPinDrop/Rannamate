# Public URL of the NestJS backend (Phase 3). The frontend never talks to the AI service directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Live AI for Cooking Mate (optional, server-side only — never exposed to the browser) ----
# Set ONE of these in .env.local. Without a key, Mate uses its built-in offline brain.
# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Mate speaks in YOUR voice (optional) ----
# Inworld (recommended): Portal → API Keys → copy the "Basic (Base64)" value as-is.
# Voice ID: TTS Playground → your cloned voice → copy its ID. Without it, the built-in "Sarah" voice is used.
INWORLD_API_KEY=
INWORLD_VOICE_ID=
# INWORLD_MODEL=inworld-tts-2
# INWORLD_SPEAKING_RATE=1
# Or ElevenLabs instead:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
